# GitHub token with public repo read access (Actions logs and metadata).
GITHUB_TOKEN=

# OpenRouter key used by the Jev wrapper. Never commit the real value.
OPENROUTER_API_KEY=

# shadow is the default. Set TRIAGE_MODE=live and TRIAGE_DRY_RUN=0 to take real actions.
TRIAGE_MODE=shadow
TRIAGE_DRY_RUN=1
# Set to 1 to force shadow mode immediately.
TRIAGE_KILL_SWITCH=

# Optional. Weekly report posts only when this is set and TRIAGE_DRY_RUN=0.
SLACK_WEBHOOK_URL=
